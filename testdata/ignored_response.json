{
  "services": [
    {
      "name": "app",
      "labels": {
        "app": "app",
        "traefik.enable": "true",
        "traefik.bogus": "x",
        "traefik.http.routers.app.rule": "Host(`app.lab.dsb.dev`)",
        "traefik.http.routers.app.priority": "high",
        "traefik.http.routers.app.unknown": "x",
        "traefik.http.services.other.loadbalancer.server.scheme": "https"
      },
      "target": { "labels": { "app": "app" }, "port": 8080, "protocol": "tcp" },
      "backends": [
        { "workload": "app", "instance": 0, "address": "10.0.0.5:20030" }
      ]
    }
  ]
}
