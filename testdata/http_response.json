{
  "services": [
    {
      "name": "home-assistant",
      "labels": {
        "traefik.enable": "true",
        "traefik.http.routers.home-assistant.rule": "Host(`ha.lab.dsb.dev`)",
        "traefik.http.routers.home-assistant.entrypoints": "https",
        "traefik.http.routers.home-assistant.tls.certresolver": "cloudflare"
      },
      "target": { "labels": { "app": "home-assistant" }, "port": 8123, "protocol": "tcp" },
      "backends": [
        { "workload": "home-assistant", "instance": 0, "address": "10.0.0.5:20000" },
        { "workload": "home-assistant", "instance": 1, "address": "10.0.0.5:20001" }
      ]
    }
  ]
}
